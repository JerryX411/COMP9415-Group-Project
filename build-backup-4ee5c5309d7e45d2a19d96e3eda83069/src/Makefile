# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	cd /d C:\Users\yulia\Documents\xwechat_files\wxid_g8ssaugpqy0311_7819\msg\file\2026-11\Core-Explorer-Lite-Offline-Build-Windows-x64\Core-Explorer-Lite\build && $(CMAKE_COMMAND) -P C:\Users\yulia\Documents\xwechat_files\wxid_g8ssaugpqy0311_7819\msg\file\2026-11\Core-Explorer-Lite-Offline-Build-Windows-x64\Core-Explorer-Lite\build\CMakeFiles\VerifyGlobs.cmake
	cd /d C:\Users\yulia\Documents\xwechat_files\wxid_g8ssaugpqy0311_7819\msg\file\2026-11\Core-Explorer-Lite-Offline-Build-Windows-x64\Core-Explorer-Lite\build && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles\Makefile.cmake 0
.PHONY : cmake_check_build_system

